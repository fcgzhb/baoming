# ===== Baoming — environment variables (copy to apps/server/.env and fill) =====
# Secrets MUST stay out of git (.gitignore covers .env / certs).

NODE_ENV=development

# --- Server ---
PORT=3000

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=baoming
DB_PASSWORD=change-me
DB_NAME=baoming

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- WeChat Mini Program ---
WX_APP_ID=wx替换为你的appid
WX_APP_SECRET=替换为你的secret

# --- WeChat Pay (V3) ---
WXPAY_MCH_ID=替换为商户号
WXPAY_APP_ID=wx替换为你的appid
WXPAY_API_V3_KEY=替换为APIv3密钥
WXPAY_NOTIFY_URL=https://你的公网域名/api/wechat/pay/notify
WXPAY_REFUND_NOTIFY_URL=https://你的公网域名/api/wechat/refund/notify
WXPAY_CERT_SERIAL_NO=替换为证书序列号
WXPAY_PRIVATE_KEY_PATH=./certs/apiclient_key.pem
WXPAY_CERT_PATH=./certs/apiclient_cert.pem
WXPAY_PLATFORM_CERT_PATH=./certs/wxpay_pub.pem

# --- Seed admin (first run of `pnpm seed:admin`) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_DISPLAY_NAME=超管

# --- Upload (default local fallback; COS optional) ---
UPLOAD_DRIVER=local          # local | cos
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_BUCKET=                 # e.g. baoming-1254292923
# COS_REGION=                 # e.g. ap-beijing
